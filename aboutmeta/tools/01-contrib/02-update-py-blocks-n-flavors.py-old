#!/usr/bin/env python3

from pathlib import Path
import              sys

sys.path.append(str(Path(__file__).parent.parent))

from utilities.yaml_2_code import *


# --------------- #
# -- CONSTANTS -- #
# --------------- #

THIS_DIR = Path(__file__).parent

CONTRIBS_INFOS = [
#   (context  , contrib_dir_name)
    ("block"  , "block-n-flavour"),
    ("flavour", "block-n-flavour"),
]

NB_STEP_START = 4


# ----------------- #
# -- LET'S WORK! -- #
# ----------------- #

for nb_step, (context, contrib_dir_name) in enumerate(
    CONTRIBS_INFOS,
    start = NB_STEP_START
):
    if nb_step != NB_STEP_START:
        print()

    create_codes_from_yaml(
        context          = context,
        this_dir         = THIS_DIR,
        contrib_dir_name = contrib_dir_name,
        nb_step           = nb_step,
        subfolder        = context,
    )
